# DeepWiki environment template — copy to `.env` and fill in secrets.
# Both api and pipeline load settings via `core.config`.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=

GROQ_API_KEY=
ANTHROPIC_API_KEY=

REPO_CLONE_DIR=repos
DEEPWIKI_JOB_DIR=

# Optional service URLs
CODE_ANALYSIS_URL=http://localhost:8081
TS_ANALYSIS_URL=http://localhost:8082

QDRANT_AUTO_BOOTSTRAP=true
NEO4J_AUTO_REPAIR=true
